{
  "name": "Meteora",
  "use": "The Meteora app, the pitch and the videos. Values match meteora.css.",
  "color": {
    "paper": "#ffffff",
    "soft": "#f6f6f5",
    "line": "#e6e6e6",
    "ink": "#202020",
    "muted": "#8b8b8b",
    "faint": "#b5b5b5",
    "mark": "#e4e4e4",
    "markLive": "#5b5b5b",
    "red": "#c62828",
    "redDeep": "#a51f1f",
    "redSoft": "#fbeceb",
    "green": "#1f6f4a",
    "droneBlack": "#111111",
    "droneRed": "#c62828"
  },
  "type": {
    "family": "Arial, Helvetica Neue, Helvetica, sans-serif",
    "weight": 400,
    "caption": { "size": 10, "lineHeight": 1.4, "letterSpacing": "0.12em", "case": "uppercase" },
    "small": { "size": 12, "lineHeight": 1.45 },
    "body": { "size": 16, "lineHeight": 1.5 },
    "lead": { "size": 22, "lineHeight": 1.4 },
    "title": { "size": "32-64", "lineHeight": 1.08, "letterSpacing": "-0.035em" },
    "display": { "size": "44-112", "lineHeight": 1.02, "letterSpacing": "-0.035em" }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "dots": { "spacing": 18, "size": 1, "rest": "#e4e4e4", "live": "#5b5b5b", "speaking": "#c62828", "shapes": ["circle", "diamond", "triangle", "square", "star"] },
  "radius": 0,
  "line": 1,
  "motion": { "fast": "150ms", "slow": "600ms", "ease": "cubic-bezier(.2,.7,.2,1)" },
  "video": { "frame": "1920x1080", "safeMargin": 96, "background": "paper with dots", "captionColor": "muted", "accent": "red, only for alarm and Grok speaking" }
}
