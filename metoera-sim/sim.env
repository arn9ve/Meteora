# One settings file for everything that talks to the simulated drones (python -m metoera_sim.serve):
#   metoera-voice:    node --env-file=../metoera-sim/sim.env server.ts
#   metoera-redzone:  node --env-file=../metoera-sim/sim.env server.mjs
#   metoera-vision:   python -m metoera_vision --port 18800 --drones tello=127.0.0.1:50001,rmtt=127.0.0.1:50002
#   rehearsals:       node --env-file=../metoera-sim/sim.env tools/rehearse.mjs "..."   (from metoera-voice/)
# serve.py reads it too (the drones' start spots). Values set here win over .env and .env.tello,
# which the servers load afterwards, so the real drones' settings stay untouched. An empty value
# still wins (it blanks the real one).
#
# Every port differs from the real setup, so the simulator can run next to real flights on the
# same laptop: it never takes 8889, 8890, 18787, 18789, 18790 or 18791.

# The voice page: http://localhost:18797. No phone link (the simulated phones talk to the red-zone
# service on this computer).
METOERA_PORT=18797
PHONE_PORT=18798
PHONE_CERT_PORT=18796
PHONE_ACCESS=off

# Black (droneId tello) and Red (droneId rmtt), both on this computer.
TELLO_IP=127.0.0.1
TELLO_PORT=9001
TELLO_SETUP_SERIAL=SIMTELLO0001
RMTT_IP=127.0.0.1
RMTT_PORT=9002
RMTT_SETUP_SERIAL=SIMRMTT00002
# Where the server hears replies and telemetry (the real drones use 8889 and 8890). Both drones
# are at 127.0.0.1 and telemetry is told apart by address only, so each needs its own port.
TELLO_LOCAL_PORT=8879
TELLO_STATE_PORT=8880
RMTT_STATE_PORT=8881

# Where the drones stand before their first takeoff when they are not placed on the Room panel:
# "x,y,heading" in cm and degrees, in the venue plan's frame (room/capannone-gragnani.json: x to
# the right, y up, heading counterclockwise from +x). Black on the floor over mission pad 1, facing
# pad 2 two metres ahead (Masoud's pad hop); Red on table 3, to take off from a table. serve.py
# starts the simulated drones here; venue/room.json places them the same way on the Room panel.
TELLO_START=620,-300,90
RMTT_START=421,-137,90

# What the voice server learns and records (.room.json with the tables, phones and red zones you
# place on the Room panel, .odometry.json, flights/, photos/) goes here, not next to the real
# drones' files. serve.py reads the same .room.json: tables become furniture in the venue, phones
# become simulated cameras, and a landed drone you move on the plan is carried there.
METOERA_DATA_DIR=../metoera-sim/voice-data

# The simulator's own metoera-vision and metoera-redzone (the real ones use 18790 and 18791).
VISION_URL=http://127.0.0.1:18800
REDZONE_URL=http://127.0.0.1:18801
REDZONE_PORT=18801
REDZONE_PHONE_PORT=18802
REDZONE_DATA_DIR=../metoera-sim/redzone-data
# The red-zone service sends its pad missions to this voice server, not the real one on 18787.
METOERA_VOICE_URL=http://127.0.0.1:18797

# Keep the simulated drones away from teammates' laptops: they listen for announcements on
# 18789, this server announces on 18799, and never to the peers listed in the real .env.tello.
METOERA_CLAIMS_PORT=18799
METOERA_PEERS=
METOERA_CLIENT_NAME=simulator
