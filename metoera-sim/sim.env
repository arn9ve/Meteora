# metoera-voice against the simulated drones (python -m metoera_sim.serve), from metoera-voice/:
#   node --env-file=../metoera-sim/sim.env server.ts
# Values set here win over .env and .env.tello, which the server loads afterwards, so the real
# drones' settings stay untouched. An empty value still wins (it blanks the real one).
#
# Every port differs from the real setup, so this server can run next to a real one on the same
# laptop and never holds the ports a real flight needs (8889, 8890, 18787, 18789).

# The page: http://localhost:18797 (phones: 18798).
METOERA_PORT=18797
PHONE_PORT=18798

# Black (droneId tello) and Red (droneId rmtt), both on this computer.
TELLO_IP=127.0.0.1
TELLO_PORT=9001
TELLO_SETUP_SERIAL=SIMTELLO0001
RMTT_IP=127.0.0.1
RMTT_PORT=9002
RMTT_SETUP_SERIAL=SIMRMTT00002
# Where the server hears replies and telemetry (the real drones use 8889 and 8890). Both drones
# are at 127.0.0.1 and telemetry is told apart by address only, so each needs its own port.
TELLO_LOCAL_PORT=8879
TELLO_STATE_PORT=8880
RMTT_STATE_PORT=8881

# Keep the simulated drones away from teammates' laptops: they listen for announcements on
# 18789, this server announces on 18799, and never to the peers listed in the real .env.tello.
METOERA_CLAIMS_PORT=18799
METOERA_PEERS=
METOERA_CLIENT_NAME=simulator
