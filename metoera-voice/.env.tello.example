# Local Tello setup values. Copy to .env.tello (git-ignored) and fill in.
# Shared 2.4 GHz WPA2 network the drone should join (no spaces).
TELLO_SETUP_SSID=hackathon
TELLO_SETUP_PASSWORD=
# Serial as reported by the drone (`sn?`), not just read off the label.
TELLO_SETUP_SERIAL=
# Enables the real drone in the voice server. Find it with `arp -an` (MAC starts 60:60:1f) or find_tello.py.
TELLO_IP=
# Optional: raise the per-move limit for voice (default 100, SDK max 500).
# TELLO_MAX_MOVE_CM=100
# Optional second drone (RoboMaster TT), voice droneId 'rmtt'. Must be on the same network, different IP.
# Both drones share local UDP 8889/8890 in one server process.
# RMTT_SETUP_SERIAL=
# RMTT_IP=
# Several laptops (see README "Several laptops"). The name the other laptops show for this one:
# METOERA_CLIENT_NAME=
# Other laptops' IPs, only when the Wi-Fi blocks broadcasts (ip[:port],...):
# METOERA_PEERS=
# Announcement port; the same on every laptop:
# METOERA_CLAIMS_PORT=18789
